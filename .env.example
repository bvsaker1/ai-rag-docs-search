# ── Provider API Keys ─────────────────────────────────────────────────────────
# LLM calls (generation, judging) go through OpenRouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Papers ─────────────────────────────────────────────────────────────────────
# Ingest the first MAX_PAPERS PDFs in PAPERS_DIR (sorted by arXiv id) that have queries in QRELS_FILE,
# plus the first MAX_NEGATIVES that don't (hard negatives).
PAPERS_DIR=data/papers
QRELS_FILE=data/pdf/arxiv/qrels.json
MAX_PAPERS=50
MAX_NEGATIVES=0
PDF_PARSE_LIB=pymupdf

# ── Chunking ───────────────────────────────────────────────────────────────────
# CHUNK_SIZE and OVERLAP are measured in tiktoken tokens. CHUNK_SIZE is the maximum for RECURSIVE and SEMANTIC.
CHUNK_SIZE=512
OVERLAP=75
TIKTOKEN_ENCODING=cl100k_base
CHUNK_METHOD_1=FIXED
CHUNK_METHOD_2=RECURSIVE
CHUNK_METHOD_3=SEMANTIC
# RECURSIVE: sections split by paragraph → sentence → word → token, packed to CHUNK_SIZE with OVERLAP tokens
# of overlap; chunks never cross sections. Sections under RECURSIVE_MIN_SECTION_TOKENS merge into the next.
RECURSIVE_MIN_SECTION_TOKENS=50
# SEMANTIC: cut where neighboring sentences' embedding distance is in the top (100 - percentile)%,
# once a chunk has SEMANTIC_MIN_TOKENS tokens; CHUNK_SIZE is the maximum. No overlap.
SEMANTIC_CHUNK_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_BREAKPOINT_PERCENTILE=95
SEMANTIC_MIN_TOKENS=50

# ── Embeddings & Vector DB ─────────────────────────────────────────────────────
# sentence-transformers models, run locally. MiniLM reads 256 tokens, mpnet 384; longer chunks are truncated.
EMBEDDING_MODEL_1=all-MiniLM-L6-v2
EMBEDDING_MODEL_2=all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32
VECTOR_DB=FAISS

# ── Retrieval ──────────────────────────────────────────────────────────────────
# bm25: keyword | dense: FAISS embedding similarity | hybrid: fusion of bm25 + dense
RETRIEVAL_1=bm25
RETRIEVAL_2=dense
RETRIEVAL_3=hybrid
TOP_K=5
# Hybrid: min-max normalized scores combined as HYBRID_ALPHA * dense + (1 - HYBRID_ALPHA) * bm25,
# over the top HYBRID_CANDIDATES from each.
HYBRID_ALPHA=0.5
HYBRID_CANDIDATES=50
# Reranking: none | cross-encoder | cohere. When on, the top RERANK_CANDIDATES are reordered and cut to TOP_K.
RERANKER=none
RERANK_CANDIDATES=20
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_RERANK_MODEL=cohere/rerank-v3.5

# ── Query set ──────────────────────────────────────────────────────────────────
# QUERY_COUNT queries from the ingested papers (at most one per paper): QUERY_ABSTRACTIVE abstractive,
# the rest extractive, split across sources by QUERY_SOURCE_MIX (largest-remainder rounding).
QUERIES_FILE=data/pdf/arxiv/queries.json
ANSWERS_FILE=data/pdf/arxiv/answers.json
QUERY_COUNT=12
QUERY_ABSTRACTIVE=8
QUERY_SOURCE_MIX=text:0.65,text-image:0.25,text-table:0.05,text-table-image:0.05
QUERY_SEED=42

# ── Generation & judging (OpenRouter) ──────────────────────────────────────────
GENERATION_MODEL=openai/gpt-6-luna
# Compared by compare_generators.py and scored by JUDGE_MODEL (a different provider).
GENERATION_CANDIDATES=anthropic/claude-haiku-5.5,openai/gpt-6-luna,google/gemini-2.5-flash-lite
GENERATION_TEMPERATURE=0
JUDGE_MODEL=deepseek/deepseek-v4-flash
JUDGE_TEMPERATURE=0
LLM_CONCURRENCY=8
LLM_MAX_ATTEMPTS=3

# ── Evaluation ─────────────────────────────────────────────────────────────────
# Ground truth: a chunk is relevant when at least RELEVANCE_MIN_OVERLAP of its word RELEVANCE_NGRAM-grams
# appear in the qrels section's corpus text, or of the section's appear in the chunk.
CORPUS_DIR=data/pdf/arxiv/corpus
RELEVANCE_MIN_OVERLAP=0.5
RELEVANCE_NGRAM=3
METRIC_K=5

# ── Logging & Iteration ────────────────────────────────────────────────────────
LOG_BASE=rag_log
ITERATION=1
